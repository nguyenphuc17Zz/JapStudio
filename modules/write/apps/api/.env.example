# ============================================================
# Backend environment template — copy to .env and edit locally.
# NEVER commit real secrets. .env is git-ignored.
# ============================================================

# Application
APP_ENV=development
APP_DEBUG=false

# Database (async MySQL URL; use your real credentials)
DATABASE_URL=mysql+aiomysql://root@localhost:3306/ai_japanese_writing

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=INFO

# ============================================================
# AI providers
# ============================================================
# Default provider used when no provider is requested explicitly.
# 'fake' works out of the box without any credentials.
AI_DEFAULT_PROVIDER=fake

# Optional default model override for the default provider
AI_DEFAULT_MODEL=

# Transient failures are retried up to AI_MAX_RETRIES times with
# exponential backoff starting at AI_RETRY_BACKOFF seconds, then the
# fallback providers below are tried in order.
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT=60
AI_RETRY_BACKOFF=1
# Comma-separated alternative providers, e.g. AI_FALLBACK_PROVIDERS=groq,ollama
AI_FALLBACK_PROVIDERS=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# Ollama (local server; http://127.0.0.1:11434 by default)
OLLAMA_BASE_URL=
OLLAMA_DEFAULT_MODEL=llama3.2

# ============================================================
# Exercise generation (Phase 3)
# ============================================================
# Provider/model used for exercise planning + content generation.
# Empty values fall back to AI_DEFAULT_PROVIDER / provider default model.
AI_EXERCISE_GENERATION_PROVIDER=
AI_EXERCISE_GENERATION_MODEL=
AI_EXERCISE_GENERATION_MAX_TOKENS=1024

# Provider/model used for the quality validator stage.
# Empty values fall back to the generation task settings.
AI_EXERCISE_VALIDATION_PROVIDER=
AI_EXERCISE_VALIDATION_MODEL=
AI_EXERCISE_VALIDATION_MAX_TOKENS=512

# Extra generation attempts after a validator rejection or duplicate
# detection (initial attempt + this many regenerations).
AI_EXERCISE_MAX_REGENERATION_ATTEMPTS=1

# Deduplication: window of recent prompts scanned for near duplicates and
# the similarity ratio above which a prompt is considered a duplicate.
AI_EXERCISE_RECENT_PROMPT_WINDOW=100
AI_EXERCISE_NEAR_DUPLICATE_THRESHOLD=0.88

# ============================================================
# Writing evaluation (Phase 4)
# ============================================================
# Provider/model used for all evaluation stages (semantic, grammar +
# vocabulary, naturalness + register, corrections, hints). Empty values
# fall back to the generation task settings, then AI_DEFAULT_PROVIDER.
AI_EXERCISE_EVALUATION_PROVIDER=
AI_EXERCISE_EVALUATION_MODEL=
AI_EXERCISE_EVALUATION_MAX_TOKENS=1024

# Per-stage model overrides (empty -> AI_EXERCISE_EVALUATION_MODEL).
AI_EXERCISE_EVALUATION_MODEL_SEMANTIC=
AI_EXERCISE_EVALUATION_MODEL_GRAMMAR=
AI_EXERCISE_EVALUATION_MODEL_NATURALNESS=
AI_EXERCISE_EVALUATION_MODEL_CORRECTION=
AI_EXERCISE_EVALUATION_MODEL_HINT=

# Extra full-pipeline cycles when consistency validation rejects a result
# (initial cycle + this many regenerations). Exhaustion -> 502.
AI_EXERCISE_EVALUATION_MAX_RETRIES=2

# Learning mode: hide corrections until hints are exhausted or the learner
# explicitly reveals the answer. Disable to return corrections immediately.
AI_EXERCISE_LEARNING_MODE_ENABLED=true

# Run the optional verifier stage after corrections; a rejected result
# triggers a new pipeline cycle.
AI_EXERCISE_EVALUATION_VERIFICATION_ENABLED=false

# Overall-score synthesis weights (normalized when the sum is not 100).
AI_EVALUATION_WEIGHT_SEMANTIC=25
AI_EVALUATION_WEIGHT_GRAMMAR=20
AI_EVALUATION_WEIGHT_VOCABULARY=10
AI_EVALUATION_WEIGHT_NATURALNESS=30
AI_EVALUATION_WEIGHT_CONTEXT_FIT=10
AI_EVALUATION_WEIGHT_REGISTER_FIT=5

# ============================================================
# Vocabulary intelligence (Phase 5)
# ============================================================
# Provider/model used for the vocabulary extraction, validation and
# explanation stages. Empty values fall back to the evaluation provider,
# then the generation provider, then AI_DEFAULT_PROVIDER.
AI_VOCABULARY_PROVIDER=
AI_VOCABULARY_MODEL=
# Per-stage model overrides (empty -> AI_VOCABULARY_MODEL).
AI_VOCABULARY_VALIDATION_MODEL=
AI_VOCABULARY_EXPLANATION_MODEL=
# Max tokens for vocabulary stage responses.
AI_VOCABULARY_MAX_TOKENS=1024
# Candidates with importance below this threshold are skipped.
AI_VOCABULARY_MIN_IMPORTANCE=4
# Run vocabulary extraction automatically after every submission.
# Disable to extract only on demand (reprocess / extract endpoints).
AI_VOCABULARY_AUTO_EXTRACT_ENABLED=true

# API keys can also be configured from the Settings page; values saved
# there are stored in the ai_provider_configs table and override the
# environment variables above. Integration tests:
#   RUN_GEMINI_INTEGRATION=true pytest tests/integration
#   RUN_OLLAMA_INTEGRATION=true pytest tests/integration

# ============================================================
# Adaptive learning engine (Phase 6)
# ============================================================
# Provider/model used for the learner-profile synthesis, mistake
# clustering, learning-planning and recommendation-explanation stages.
# Empty values fall back to AI_DEFAULT_PROVIDER / provider default model.
AI_LEARNING_PROVIDER=
AI_LEARNING_MODEL=
AI_LEARNING_PROFILE_MODEL=
AI_LEARNING_MAX_TOKENS=1024

# Strategy mix for recommendations (must sum to 100):
# targeted (weakness drilling), reinforcement (maintenance), exploration.
AI_LEARNING_STRATEGY_TARGETED=70
AI_LEARNING_STRATEGY_REINFORCEMENT=20
AI_LEARNING_STRATEGY_EXPLORATION=10

# Re-synthesize the learner profile after this many new evaluations.
AI_LEARNING_PROFILE_REFRESH_INTERVAL=10
# Clamp recommendation difficulty/JLPT to the learner's current level.
AI_LEARNING_MAX_DIFFICULTY_STEP=2
AI_LEARNING_MAX_JLPT_STEP=1
# Recency half-life (days) for evidence weighting.
AI_LEARNING_RECENCY_HALF_LIFE_DAYS=30
# Maximum evaluations included in the evidence summary.
AI_LEARNING_EVIDENCE_WINDOW=200
# Update the learner state automatically after every submission.
# Disable to keep learning updates manual-only (refresh endpoint).
AI_LEARNING_AUTO_UPDATE_ENABLED=true
# ============================================================
# AI quality layer (Phase 11)
# ============================================================
# Minimum confidence for accepting a result without extra scrutiny.
AI_QUALITY_MIN_CONFIDENCE=medium
# Provider score disagreement above this delta triggers resolution.
AI_QUALITY_MAX_PROVIDER_DISAGREEMENT=25
# Regeneration budget for rejected results (per task).
AI_QUALITY_MAX_RETRIES=2
# Allow secondary AI verification of critical/high-impact results.
AI_QUALITY_VERIFICATION_ENABLED=false
# Allow escalating to a stronger model when results stay suspicious.
AI_QUALITY_ESCALATION_ENABLED=true
# Expose the developer diagnostics (quality status / telemetry / benchmark).
AI_QUALITY_DIAGNOSTICS_ENABLED=true
# Record privacy-safe telemetry events (never raw user content).
AI_QUALITY_TELEMETRY_ENABLED=true
# Optional dedicated verifier provider/model (empty -> primary task settings).
AI_QUALITY_VERIFICATION_PROVIDER=
AI_QUALITY_VERIFICATION_MODEL=
# Optional stronger model used when escalation is triggered (empty -> same).
AI_QUALITY_ESCALATION_MODEL=
# Minimum evidence count before evidence can drive profile/recommendation.
AI_QUALITY_EVIDENCE_MIN_COUNT=3
# Per-task cost profiles: e.g. encouragement:cheap,writing_evaluation:quality
AI_QUALITY_COST_PROFILES=

# ============================================================
# Personal AI memory (Phase 12)
# ============================================================
# Enable inferred learner memory. When off, no new inferred memories are
# created and none are retrieved; existing memories stay stored but unused.
AI_MEMORY_ENABLED=true
# Provider/model for memory stages. Empty falls back to memory -> learning ->
# evaluation -> AI_DEFAULT_PROVIDER chain.
AI_MEMORY_PROVIDER=
AI_MEMORY_MODEL=
AI_MEMORY_VALIDATION_MODEL=
AI_MEMORY_CONFLICT_MODEL=
AI_MEMORY_MAX_TOKENS=1024
# Retrieval budget: max memories and max tokens sent into an AI prompt.
AI_MEMORY_MAX_ITEMS=6
AI_MEMORY_CONTEXT_MAX_TOKENS=800
# Skip candidates below this importance (1-10) or confidence.
AI_MEMORY_MIN_IMPORTANCE=4
AI_MEMORY_MIN_CONFIDENCE=medium
# Temporary-class memories (goals, target-level) expire after this many days.
AI_MEMORY_TEMPORARY_EXPIRY_DAYS=90
