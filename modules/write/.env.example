# ============================================================
# AI Japanese Writing Tutor — root environment template
# Copy relevant values into apps/api/.env and apps/web/.env
# NEVER commit real secrets. This file is a template only.
# ============================================================

# ---------- Backend (apps/api/.env) ----------
# Async MySQL URL. Use your real credentials locally.
DATABASE_URL=mysql+aiomysql://root@localhost:3306/ai_japanese_writing

# Optional AI provider keys (Phase 2+; leave empty for now)
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=

# ---------- Gamification (Phase 7; defaults shown, all optional) ----------
# Feature switches
GAMIFICATION_ENABLED=true
AI_CHALLENGE_ENABLED=true
AI_DAILY_MISSION_ENABLED=true
AI_PROGRESS_SUMMARY_ENABLED=true
AI_ENCOURAGEMENT_ENABLED=true

# XP economy (deterministic; tune per-product)
XP_EXERCISE_COMPLETE=10
XP_HIGH_SCORE_BONUS=5
XP_RETRY_IMPROVEMENT=5
XP_CHALLENGE_COMPLETE=15
XP_DAILY_GOAL=25
XP_MILESTONE=50
XP_MISSION_COMPLETE=0
XP_HIGH_SCORE_THRESHOLD=80
XP_RETRY_IMPROVEMENT_DELTA=5
XP_LEVEL_BASE=100

# AI models for the gamification layer (optional; falls back to provider chain)
AI_GAMIFICATION_PROVIDER=
AI_GAMIFICATION_MODEL=
AI_DAILY_MISSION_MODEL=
AI_CHALLENGE_MODEL=
AI_PROGRESS_SUMMARY_MODEL=
AI_MILESTONE_MODEL=
AI_ENCOURAGEMENT_MODEL=
AI_GAMIFICATION_MAX_TOKENS=1024

# Challenge behavior
AI_CHALLENGE_FREQUENCY=3
AI_CHALLENGE_SUCCESS_THRESHOLD=80

# ---------- Long-form writing & discourse intelligence (Phase 8; defaults shown, all optional) ----------
# Master switch; when off, /api/v1/writing returns 400 feature_disabled
AI_LONG_FORM_ENABLED=true
# AI models for the writing workspace (optional; falls back to provider chain)
AI_LONG_FORM_PROVIDER=
AI_LONG_FORM_MODEL=
AI_LONG_FORM_COACH_MODEL=
AI_LONG_FORM_MAX_TOKENS=1536
# Evaluate each sentence with the Phase 4 pipeline (per-sentence scores + issues)
AI_LONG_FORM_SENTENCE_EVALUATION_ENABLED=true
# Use the AI to segment the draft into sentences (default: deterministic segmentation)
AI_LONG_FORM_AI_SEGMENTATION_ENABLED=false
# Hard cap on sentences per draft (validation error above)
AI_LONG_FORM_MAX_SENTENCES=30
# Overall writing = sentence_quality * weight% + discourse_quality * (100 - weight)%
AI_LONG_FORM_OVERALL_SENTENCE_WEIGHT=50
# AI guidance when comparing two revisions
AI_LONG_FORM_REVISION_GUIDANCE_ENABLED=true

# Discourse quality dimension weights (must sum to 100)
AI_DISCOURSE_WEIGHT_COHERENCE=25
AI_DISCOURSE_WEIGHT_COHESION=20
AI_DISCOURSE_WEIGHT_ORGANIZATION=15
AI_DISCOURSE_WEIGHT_FLOW=20
AI_DISCOURSE_WEIGHT_STYLE=10
AI_DISCOURSE_WEIGHT_REDUNDANCY=10

# Shared Phase 4/5/6 toggles used by the writing workspace
AI_EXERCISE_LEARNING_MODE_ENABLED=true
AI_EXERCISE_EVALUATION_MAX_RETRIES=2
AI_VOCABULARY_AUTO_EXTRACT_ENABLED=true
AI_LEARNING_AUTO_UPDATE_ENABLED=true

# ---------- Frontend (apps/web/.env) ----------
# Base URL of the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000