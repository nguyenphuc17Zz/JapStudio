ENVIRONMENT=development
PORT=8002
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:3002","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:3002","http://127.0.0.1:5173"]
DATABASE_URL=sqlite+aiosqlite:///./immersion.db
ENCRYPTION_KEY=dGhpc2lzYTMyeGJ5dGVrZXlmb3JjcnlwdG9ncmFwaHk=
LOG_LEVEL=INFO
# Browser-fallback extraction chain (direct -> headless Chromium when walled).
# Requires: pip install playwright && playwright install chromium
EXTRACTION_BROWSER_ENABLED=true
BROWSER_MAX_CONCURRENCY=2
BROWSER_TIMEOUT_SECONDS=25.0
# Local embedding model for topic discovery (weights in ./models/, git-ignored).
# Requires: pip install fastembed numpy (first run downloads ~400MB into ./models).
EMBEDDING_MODEL_DIR=./models
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_CLUSTERING_ENABLED=false
